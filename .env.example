# Copia este archivo como ".env" y ajusta los valores a tu entorno local.

# Seguridad
DJANGO_SECRET_KEY=cambia-esta-clave-por-una-segura
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Base de datos PostgreSQL
DB_NAME=Pro_Gol
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=127.0.0.1
DB_PORT=5432
